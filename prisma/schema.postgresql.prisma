// Prisma Schema for VELORA Compliance MVP (PostgreSQL / Supabase / Neon Production Target)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  plan                    String                   @default("ENTERPRISE_DEMO")
  isDemo                  Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  memberships             Membership[]
  businesses              Business[]
  processes               Process[]
  diagnostics             Diagnostic[]
  diagnosticResponses     DiagnosticResponse[]
  evidences               Evidence[]
  evidenceDocuments       EvidenceDocument[]
  evidenceMappings        EvidenceMapping[]
  assessments             ComplianceAssessment[]
  findings                ComplianceFinding[]
  riskAssessments         RiskAssessment[]
  remediationActions      RemediationAction[]
  calendarItems           ComplianceCalendarItem[]
  audits                  Audit[]
  auditEvents             AuditEvent[]
  reports                 Report[]
  serviceRequests         NKVVServiceRequest[]
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String
  passwordHash  String?
  avatarUrl     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   Membership[]
}

model Membership {
  id              String       @id @default(uuid())
  organizationId  String
  userId          String
  role            String       @default("VIEWER") // OWNER, ADMIN, ASSESSOR, VIEWER
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Business {
  id                String                   @id @default(uuid())
  organizationId    String
  name              String
  code              String
  isDemo            Boolean                  @default(false)
  status            String                   @default("ACTIVE")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile           BusinessProfile?
  workforce         WorkforceProfile?
  processes         Process[]
  diagnostics       Diagnostic[]
  evidences         Evidence[]
  assessments       ComplianceAssessment[]
  calendarItems     ComplianceCalendarItem[]
  audits            Audit[]
  auditEvents       AuditEvent[]
  reports           Report[]
  serviceRequests   NKVVServiceRequest[]
}

model BusinessProfile {
  id                       String       @id @default(uuid())
  businessId               String       @unique
  legalEntityType          String
  industry                 String
  state                    String
  city                     String
  establishmentType        String
  payrollSystem            String?
  attendanceSystem         String?
  hrisSystem               String?
  currentHrProcess         String?
  complianceResponsibility String?
  existingConsultant       String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  business                 Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model WorkforceProfile {
  id                     String       @id @default(uuid())
  businessId             String       @unique
  employeeCount          Int          @default(0)
  workerCount            Int          @default(0)
  contractWorkerCount    Int          @default(0)
  migrantWorkerStatus    Boolean      @default(false)
  factoryStatus          Boolean      @default(false)
  constructionActivity   Boolean      @default(false)
  hazardousActivity      Boolean      @default(false)
  shiftWork              Boolean      @default(false)
  workingHours           Float        @default(8.0)
  womenEmployees         Int          @default(0)
  contractLabourUsage    Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  business               Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Process {
  id              String       @id @default(uuid())
  organizationId  String
  businessId      String
  processName     String
  category        String
  currentTool     String?
  maturityLevel   String       @default("DEVELOPING")
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model LegalSource {
  id              String             @id @default(uuid())
  sourceId        String             @unique
  title           String
  sourceType      String
  jurisdiction    String
  authorityLevel  String
  fileReference   String?
  effectiveDate   String
  version         String             @default("1.0")
  status          String             @default("PUBLISHED")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  rules           LegalRule[]
}

model LegalRule {
  id                       String               @id @default(uuid())
  ruleId                   String               @unique
  lawId                    String
  sourceId                 String
  legalSourceId            String
  section                  String
  subsection               String?
  ruleReference            String?
  requirement              String
  applicabilityLogic       String
  jurisdiction             String
  state                    String?
  industry                 String?
  establishmentType        String?
  employeeThreshold        Int?
  workerThreshold          Int?
  contractWorkerThreshold  Int?
  effectiveFrom            String
  effectiveTo              String?
  evidenceRequired         String
  complianceTest           String
  riskLevel                String
  remediationGuidance      String
  sourcePage               String?
  sourceTextReference      String
  version                  String               @default("1.0")
  status                   String               @default("PUBLISHED")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  source                   LegalSource          @relation(fields: [legalSourceId], references: [id], onDelete: Cascade)
  versions                 LegalRuleVersion[]
  applicabilityRules       ApplicabilityRule[]
  evidenceMappings         EvidenceMapping[]
  findings                 ComplianceFinding[]
}

model LegalRuleVersion {
  id             String       @id @default(uuid())
  legalRuleId    String
  versionNumber  String
  changedBy      String
  changeSummary  String
  ruleSnapshot   String
  status         String
  createdAt      DateTime     @default(now())

  rule           LegalRule    @relation(fields: [legalRuleId], references: [id], onDelete: Cascade)
}

model ApplicabilityRule {
  id                   String       @id @default(uuid())
  legalRuleId          String
  ruleKey              String
  conditionType        String
  parameter            String
  operator             String
  value                String
  explanationTemplate  String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  legalRule            LegalRule    @relation(fields: [legalRuleId], references: [id], onDelete: Cascade)
}

model DiagnosticQuestion {
  id                      String               @id @default(uuid())
  questionCode            String               @unique
  category                String
  questionText            String
  helpText                String?
  applicableRulesSummary  String?
  sortOrder               Int                  @default(0)
  isActive                Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  responses               DiagnosticResponse[]
}

model Diagnostic {
  id              String               @id @default(uuid())
  organizationId  String
  businessId      String
  title           String               @default("Comprehensive VELORA Diagnostic")
  status          String               @default("IN_PROGRESS")
  conductedBy     String?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  responses       DiagnosticResponse[]
}

model DiagnosticResponse {
  id               String              @id @default(uuid())
  organizationId   String
  diagnosticId     String
  questionId       String
  answer           String
  notes            String?
  confidence       String              @default("HIGH")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  diagnostic       Diagnostic          @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  question         DiagnosticQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  evidenceMappings EvidenceMapping[]

  @@unique([diagnosticId, questionId])
}

model Evidence {
  id              String              @id @default(uuid())
  organizationId  String
  businessId      String
  title           String
  category        String
  status          String              @default("UNVERIFIED")
  notes           String?
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business        Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  documents       EvidenceDocument[]
  mappings        EvidenceMapping[]
}

model EvidenceDocument {
  id                 String       @id @default(uuid())
  organizationId     String
  evidenceId         String
  fileName           String
  fileType           String
  fileSize           Int
  fileUrl            String
  storageKey         String
  extractedMetadata  String?
  uploadedBy         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence           Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
}

model EvidenceMapping {
  id                    String              @id @default(uuid())
  organizationId        String
  evidenceId            String
  legalRuleId           String?
  complianceFindingId   String?
  diagnosticResponseId  String?
  relevanceScore        Float               @default(1.0)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence              Evidence            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  legalRule             LegalRule?          @relation(fields: [legalRuleId], references: [id], onDelete: SetNull)
  finding               ComplianceFinding?  @relation(fields: [complianceFindingId], references: [id], onDelete: SetNull)
  diagnosticResponse    DiagnosticResponse? @relation(fields: [diagnosticResponseId], references: [id], onDelete: SetNull)
}

model ComplianceAssessment {
  id                     String              @id @default(uuid())
  organizationId         String
  businessId             String
  status                 String              @default("COMPLETED")
  overallScore           Float               @default(0.0)
  legalComplianceScore   Float               @default(0.0)
  documentationScore     Float               @default(0.0)
  payrollScore           Float               @default(0.0)
  statutoryScore         Float               @default(0.0)
  hrProcessScore         Float               @default(0.0)
  evidenceReadinessScore Float               @default(0.0)
  auditReadinessScore    Float               @default(0.0)
  assessedBy             String?
  summary                String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business               Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  findings               ComplianceFinding[]
  riskAssessments        RiskAssessment[]
  reports                Report[]
}

model ComplianceFinding {
  id                    String               @id @default(uuid())
  organizationId        String
  assessmentId          String
  legalRuleId           String?
  findingCode           String
  title                 String
  description           String
  law                   String
  section               String
  sourceText            String
  applicabilityReason   String
  evidenceSummary       String?
  gapAnalysis           String
  riskLevel             String
  recommendation        String
  owner                 String?
  priority              String               @default("HIGH")
  dueDate               DateTime?
  status                String               @default("NON_COMPLIANT")
  confidence            String               @default("HIGH")
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment            ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  legalRule             LegalRule?           @relation(fields: [legalRuleId], references: [id], onDelete: SetNull)
  remediationActions    RemediationAction[]
  riskAssessments       RiskAssessment[]
  evidenceMappings      EvidenceMapping[]
}

model RiskAssessment {
  id                  String               @id @default(uuid())
  organizationId      String
  assessmentId        String
  findingId           String?
  riskLevel           String
  impactDescription   String
  likelihood          String
  potentialExposure   String?
  mitigationStrategy  String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment          ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  finding             ComplianceFinding?   @relation(fields: [findingId], references: [id], onDelete: SetNull)
}

model RemediationAction {
  id                  String             @id @default(uuid())
  organizationId      String
  findingId           String
  actionTitle         String
  actionDescription   String
  owner               String?
  priority            String             @default("HIGH")
  dueDate             DateTime?
  status              String             @default("OPEN")
  notes               String?
  resolvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finding             ComplianceFinding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
}

model ComplianceCalendarItem {
  id                  String       @id @default(uuid())
  organizationId      String
  businessId          String
  title               String
  law                 String
  formNumber          String?
  frequency           String
  dueDate             DateTime
  statutoryAuthority  String
  status              String       @default("UPCOMING")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business            Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Audit {
  id              String       @id @default(uuid())
  organizationId  String
  businessId      String
  auditName       String
  scope           String
  auditor         String
  status          String       @default("PLANNED")
  findingsCount   Int          @default(0)
  score           Float?
  startDate       DateTime
  completedDate   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events          AuditEvent[]
}

model AuditEvent {
  id              String        @id @default(uuid())
  organizationId  String
  auditId         String?
  businessId      String?
  eventType       String
  entityType      String
  entityId        String
  actorId         String?
  actorEmail      String?
  details         String
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit           Audit?        @relation(fields: [auditId], references: [id], onDelete: SetNull)
  business        Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
}

model Report {
  id                String                @id @default(uuid())
  organizationId    String
  businessId        String
  assessmentId      String?
  reportType        String                @default("COMPLIANCE_DIAGNOSTIC")
  title             String
  executiveSummary  String
  scoreSnapshot     Float
  reportData        String
  generatedBy       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assessment        ComplianceAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
}

model NKVVServiceRequest {
  id                     String       @id @default(uuid())
  organizationId         String
  businessId             String
  requestNumber          String       @unique
  requestedService       String
  priority               String       @default("HIGH")
  description            String
  linkedFindingsSummary  String?
  status                 String       @default("SUBMITTED")
  contactName            String
  contactEmail           String
  contactPhone           String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  business               Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
